# Copy this file to .env and fill it in (`make setup` does the copy). Never commit .env.
# Slack app: Socket Mode on. Bot token (xoxb-...) from "Install App"; app-level token (xapp-..., scope connections:write).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# YOUR Slack member id (profile -> ... -> Copy member ID). You are the owner: you get the drafts and the alerts.
OWNER_USER_ID=
# YOUR GitHub org: "is anyone working on X" searches run over it. Empty = that search is off.
GITHUB_ORG=
# Repos Dex may REVIEW (only the ones you work on; empty is fine): {"owner/name": {"clone": "/path/to/existing/clone", "skill": "/review-skill"}}
#   frontend:        "skill": "/review-prs"
#   python backend:  "skill": "/review-prs-be"
#   .NET monolith:   "skill": "/review-prs-net {url}", "dex_posts": true   (put this one in repos_extra.json)
#   example:         REPOS={"your-org/your-repo":{"clone":"/path/to/your-repo","skill":"/review-prs"}}
REPOS={}

# Review skills (installed automatically when missing; see docs/skills-and-repos.md)
# SKILLS_REPO is required once REPOS lists a repo: the public repo that holds the skills
SKILLS_REPO=
# SKILLS_REPO=your-org/review-skills
# SKILLS_REF=main                       branch or tag to install (pin a tag for a reproducible install)
# SKILLS_AUTO_INSTALL=1                 install missing skills at startup (0 = only `make skills`)

# Optional (defaults in brackets)
# BOT_NAME=Dex                      how the assistant names itself in its prompts
# ALLOWED_USERS=                    comma-separated Slack ids; empty = anyone (finer control: policy.json)
# JOB_TIMEOUT_MIN=45                one PR review
# QA_TIMEOUT_MIN=10                 one answer
# MAX_QA_TURNS_PER_THREAD=15
# CONCURRENCY=1                     reviews at a time
# QA_CONCURRENCY=2                  answers at a time
# QA_BARE=1                         --bare for answers (about 4.6x cheaper)
# QA_REFRESH_SECONDS=600            how often origin/main is fetched in the existing clones
# QA_IDLE_HOURS=24                  thread sessions expire after this long idle
